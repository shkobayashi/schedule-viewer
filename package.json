{
  "name": "schedule-viewer",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/compile-validators.mjs && vite",
    "build": "node scripts/compile-validators.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:schedule": "tsx scripts/check-schedule.ts",
    "check:calendar": "tsx scripts/check-calendar.ts",
    "check:members": "tsx scripts/check-members.ts",
    "test": "node scripts/compile-validators.mjs && vitest run",
    "lint": "eslint .",
    "build:validate-skill": "node scripts/build-validate-skill.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "postinstall": "node scripts/ensure-tauri-cli-native.mjs"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-darwin-arm64": "2.11.5",
    "@tauri-apps/cli-darwin-x64": "2.11.5",
    "@tauri-apps/cli-linux-arm-gnueabihf": "2.11.5",
    "@tauri-apps/cli-linux-arm64-gnu": "2.11.5",
    "@tauri-apps/cli-linux-arm64-musl": "2.11.5",
    "@tauri-apps/cli-linux-riscv64-gnu": "2.11.5",
    "@tauri-apps/cli-linux-x64-gnu": "2.11.5",
    "@tauri-apps/cli-linux-x64-musl": "2.11.5",
    "@tauri-apps/cli-win32-arm64-msvc": "2.11.5",
    "@tauri-apps/cli-win32-ia32-msvc": "2.11.5",
    "@tauri-apps/cli-win32-x64-msvc": "2.11.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "konva": "^9.3.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
