{
  "name": "schedule-viewer",
  "private": true,
  "version": "1.12.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/compile-validators.mjs && vite",
    "build": "node scripts/compile-validators.mjs && tsc && vite build",
    "preview": "vite preview",
    "dev:manual-screenshot": "node scripts/compile-validators.mjs && vite --mode manual-screenshot",
    "capture:manual-screenshots": "node scripts/capture-user-manual-screenshots.mjs",
    "capture:design-screenshots": "node scripts/capture-design-screenshots.mjs",
    "capture:phase3-evidence": "node scripts/capture-design-screenshots.mjs --phase3-evidence",
    "capture:phase3-before": "node scripts/capture-design-screenshots.mjs --phase3-before-only",
    "capture:phase3-full": "node scripts/capture-design-screenshots.mjs --phase3-full",
    "build:manual-site": "node scripts/build-user-manual-site.mjs",
    "tauri": "tauri",
    "tauri:dev:fresh": "node scripts/tauri-dev-fresh.mjs",
    "check:schedule": "tsx scripts/check-schedule.ts",
    "check:calendar": "tsx scripts/check-calendar.ts",
    "check:members": "tsx scripts/check-members.ts",
    "check:statuses": "tsx scripts/check-statuses.ts",
    "check:colors": "tsx scripts/check-colors.ts",
    "check:mcp-tool-names": "tsx scripts/check-mcp-tool-names.ts",
    "check:operation-entries": "tsx scripts/check-operation-entries.ts",
    "check:regression-coverage": "tsx scripts/check-regression-coverage.ts",
    "check:madge-circular-baseline": "tsx scripts/check-madge-circular-baseline.ts",
    "check:architecture-warn": "node scripts/check-architecture-warn.mjs",
    "test:coverage": "vitest run --coverage",
    "test": "node scripts/compile-validators.mjs && node --test scripts/*.test.mjs && vitest run",
    "test:browser-regression": "node scripts/compile-validators.mjs && playwright test -c e2e/browser-regression/playwright.config.ts",
    "lint": "eslint . --max-warnings 48",
    "build:validate-skill": "node scripts/build-validate-skill.mjs",
    "version:check": "tsx scripts/check-version-sync.ts",
    "version:bump": "tsx scripts/bump-version.ts",
    "postinstall": "node scripts/ensure-tauri-cli-native.mjs"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-darwin-arm64": "2.12.4",
    "@tauri-apps/cli-darwin-x64": "2.12.4",
    "@tauri-apps/cli-linux-arm-gnueabihf": "2.12.4",
    "@tauri-apps/cli-linux-arm64-gnu": "2.12.4",
    "@tauri-apps/cli-linux-arm64-musl": "2.12.4",
    "@tauri-apps/cli-linux-riscv64-gnu": "2.12.4",
    "@tauri-apps/cli-linux-x64-gnu": "2.12.4",
    "@tauri-apps/cli-linux-x64-musl": "2.12.4",
    "@tauri-apps/cli-win32-arm64-msvc": "2.12.4",
    "@tauri-apps/cli-win32-ia32-msvc": "2.12.4",
    "@tauri-apps/cli-win32-x64-msvc": "2.12.4"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "konva": "^10.9.1",
    "lucide-react": "^1.61.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "jscpd": "^4.0.5",
    "jsdom": "^30.1.3",
    "madge": "^8.0.0",
    "marked": "^18.1.2",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
