{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collabcentral.example/schedule-viewer/statuses.schema.json",
  "title": "Status catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "statuses"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/status" }
    }
  },
  "$defs": {
    "statusId": {
      "type": "string",
      "minLength": 1,
      "description": "タスクの status に書く値。作ったあと変えない。"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "barColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "border"],
      "properties": {
        "bg": { "$ref": "#/$defs/hexColor", "description": "バーの地。" },
        "border": {
          "$ref": "#/$defs/hexColor",
          "description": "バーの枠と、進捗の帯の色。"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "closed", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/statusId" },
        "name": { "type": "string", "minLength": 1 },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": { "$ref": "#/$defs/barColor" },
            "dark": { "$ref": "#/$defs/barColor" }
          }
        },
        "closed": {
          "type": "boolean",
          "description": "完了として扱うか。期限超過と「完了以外」の絞り込みから外れる。"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "意味と、どの状態のタスクに付けるか。LLM が id を選ぶ手がかりにする。"
        }
      }
    }
  }
}
