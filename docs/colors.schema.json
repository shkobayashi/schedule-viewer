{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collabcentral.example/schedule-viewer/colors.schema.json",
  "title": "Row color catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "colors"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/colorItem" }
    }
  },
  "$defs": {
    "colorId": {
      "type": "string",
      "minLength": 1,
      "description": "タスクの colorId に書く値。作ったあと変えない。"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "rowColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg"],
      "properties": {
        "bg": {
          "$ref": "#/$defs/hexColor",
          "description": "行とチャートの地。"
        }
      }
    },
    "colorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/colorId" },
        "name": { "type": "string", "minLength": 1 },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": { "$ref": "#/$defs/rowColor" },
            "dark": { "$ref": "#/$defs/rowColor" }
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "この id を選ぶ状態だけ。LLM が id を選ぶ手がかりにする。"
        }
      }
    }
  }
}
