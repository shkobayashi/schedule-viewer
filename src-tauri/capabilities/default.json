{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "schedule-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-is-focused",
    "core:event:default",
    "notification:default",
    "core:menu:default",
    "allow-open-schedule-file",
    "allow-check-schedule-file-changed",
    "allow-poll-schedule-file-update",
    "allow-read-open-schedule-file",
    "allow-save-schedule-file",
    "allow-save-html-file",
    "allow-get-members-settings",
    "allow-read-member-catalog",
    "allow-import-member-catalog",
    "allow-delete-member-catalog",
    "allow-set-selected-member-catalog",
    "allow-get-calendar-state",
    "allow-read-app-calendar",
    "allow-import-app-calendar",
    "allow-delete-app-calendar",
    "allow-read-schedule-recovery",
    "allow-write-schedule-recovery",
    "allow-delete-schedule-recovery",
    "allow-read-schedule-file-at-path",
    "allow-read-last-schedule-file",
    "allow-clear-last-schedule-path",
    "allow-read-window-startup",
    "allow-create-schedule-window",
    "allow-window-session",
    "allow-schedule-peer-notice",
    "allow-json-skill-home-dirs",
    "allow-pick-json-skill-folder",
    "allow-install-json-skills",
    "allow-uninstall-json-skills",
    "updater:default",
    "process:allow-restart"
  ]
}
