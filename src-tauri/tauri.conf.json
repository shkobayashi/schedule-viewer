{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "schedule-viewer",
  "version": "1.1.1",
  "identifier": "com.collabcentral.schedule-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "schedule-viewer",
        "width": 1100,
        "height": 780
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../.cursor/skills/write-schedule/": "json-skills/write-schedule/",
      "../.cursor/skills/write-members/": "json-skills/write-members/",
      "../.cursor/skills/write-calendar/": "json-skills/write-calendar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4MjRDRTVBMkNFNzEzOEQKUldTTkUrY3NXczRrcUdibFhWMHRRZURkcUlrc3IwUFFlMUJOd3RlbGpmZzFLZU1QaFJLTjB0RVAK",
      "endpoints": [
        "https://github.com/shkobayashi/schedule-viewer/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}