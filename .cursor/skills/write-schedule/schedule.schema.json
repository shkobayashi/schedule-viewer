{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collabcentral.example/schedule-viewer/schedule.schema.json",
  "title": "Schedule document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "milestones", "categories"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 5,
      "description": "5: カテゴリとグループは id を持つ。名前は表示であり、同じスケジュールの中ではカテゴリ名、同じカテゴリの中ではグループ名が重複しない。タスクの confidence は tentative か committed。担当は assigneeId（未割当は null）。終了日はその日を含む。schemaVersion 3 は確度なしを committed として読む。schemaVersion 4 はカテゴリとグループへ id を補って読む。"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "scheduleId": {
      "type": "string",
      "format": "uuid"
    },
    "isoDate": {
      "type": "string",
      "format": "date"
    },
    "taskStatus": {
      "type": "string",
      "enum": ["not-started", "in-progress", "done"]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "date"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/isoDate" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "start",
        "end",
        "assigneeId",
        "status",
        "progress",
        "confidence",
        "predecessors",
        "milestoneId"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/isoDate" },
        "end": {
          "$ref": "#/$defs/isoDate",
          "description": "終了日（この日を含む）。開始日以降。"
        },
        "assigneeId": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "status": { "$ref": "#/$defs/taskStatus" },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": {
          "type": "string",
          "enum": ["tentative", "committed"],
          "description": "日付を合意したかどうか。着手や進捗とは独立。tentative は未確定、committed は確定。"
        },
        "predecessors": {
          "type": "array",
          "items": { "$ref": "#/$defs/scheduleId" },
          "uniqueItems": true
        },
        "milestoneId": {
          "oneOf": [
            { "$ref": "#/$defs/scheduleId" },
            { "type": "null" }
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "タスクの補足説明（任意）。画面ではノートとして表示する。"
        }
      }
    },
    "taskGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tasks"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "groups"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taskGroup" }
        }
      }
    }
  }
}
