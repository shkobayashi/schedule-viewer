{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collabcentral.example/schedule-viewer/schedule.schema.json",
  "title": "Schedule document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "milestoneGroups", "milestones"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 8,
      "description": "8: タスクの status を、ステータス一覧の id を書く文字列にする。任意の levels と outline で階層の段数を定義できる。7 以前は読み込み時に 8 へ移行し、status の値は変えない。7 はタスクに任意の tags（文字列配列）を足せる。マイルストンは milestoneGroups の groupId で帯の行に分ける。カテゴリとグループは id を持つ。タスクとマイルストンの confidence は tentative か committed。タスクの担当は assigneeId（未割当は null、一人は id の文字列、二人以上は入れた順の id 配列。マイルストンには付けない）。終了日はその日を含む。"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "milestoneGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestoneGroup" }
    },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/levelDefinition" }
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "outline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outlineChild" }
    }
  },
  "$defs": {
    "scheduleId": {
      "type": "string",
      "format": "uuid"
    },
    "isoDate": {
      "type": "string",
      "format": "date"
    },
    "taskStatus": {
      "type": "string",
      "minLength": 1,
      "description": "ステータス一覧の項目の id。既定の一覧は not-started、in-progress、done。"
    },
    "taskFieldValues": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "number" }
        ]
      }
    },
    "levelDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "meaning"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "その段に置いたあとに LLM が守ること。空ならキーを書かない。"
        }
      }
    },
    "milestoneGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "taskTodoItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "done"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "done": { "type": "boolean" }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "date", "confidence", "groupId"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/isoDate" },
        "confidence": {
          "type": "string",
          "enum": ["tentative", "committed"],
          "description": "日付を合意したかどうか。tentative は未確定、committed は確定。タスクの確度とは独立。"
        },
        "groupId": { "$ref": "#/$defs/scheduleId" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "start",
        "end",
        "assigneeId",
        "status",
        "progress",
        "confidence",
        "predecessors",
        "milestoneId"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/isoDate" },
        "end": {
          "$ref": "#/$defs/isoDate",
          "description": "終了日（この日を含む）。開始日以降。"
        },
        "assigneeId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          ],
          "description": "未割当は null。一人は id の文字列、または要素1つの配列。二人以上は入れた順の id 配列。"
        },
        "status": { "$ref": "#/$defs/taskStatus" },
        "colorId": {
          "type": "string",
          "minLength": 1,
          "description": "色の一覧の id。色なしはキーを書かない。"
        },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": {
          "type": "string",
          "enum": ["tentative", "committed"],
          "description": "日付を合意したかどうか。着手や進捗とは独立。tentative は未確定、committed は確定。"
        },
        "predecessors": {
          "type": "array",
          "items": { "$ref": "#/$defs/scheduleId" },
          "uniqueItems": true
        },
        "milestoneId": {
          "oneOf": [
            { "$ref": "#/$defs/scheduleId" },
            { "type": "null" }
          ]
        },
        "todos": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taskTodoItem" },
          "description": "進捗を件数で決める任意の項目。1件以上あるときだけ書く。"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "説明用の任意タグ。画面では絞り込みに使う。"
        },
        "fieldValues": {
          "$ref": "#/$defs/taskFieldValues",
          "description": "追加項目の値。定義の key だけ。1件以上あるときだけ書く。"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "タスクの補足説明（任意）。画面ではノートとして表示する。"
        }
      }
    },
    "outlineBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/outlineChild" }
        }
      }
    },
    "outlineChild": {
      "oneOf": [
        { "$ref": "#/$defs/outlineBranch" },
        { "$ref": "#/$defs/task" }
      ]
    },
    "taskGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tasks"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "groups"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "name": { "type": "string", "minLength": 1 },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taskGroup" }
        }
      }
    }
  }
}
