{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collabcentral.example/schedule-viewer/workspace.schema.json",
  "title": "Schedule viewer workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schedule"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "schedule": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "string",
      "minLength": 1
    },
    "calendar": {
      "type": "string",
      "minLength": 1
    },
    "statuses": {
      "type": "string",
      "minLength": 1
    },
    "colors": {
      "type": "string",
      "minLength": 1
    },
    "fieldExtensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "editableFieldExtension": {
      "type": "string",
      "minLength": 1
    }
  }
}
