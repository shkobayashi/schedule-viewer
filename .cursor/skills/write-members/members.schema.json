{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collabcentral.example/schedule-viewer/members.schema.json",
  "title": "Members catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "members"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "members": {
      "type": "array",
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "memberId": {
      "type": "string",
      "minLength": 1
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/memberId" },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
