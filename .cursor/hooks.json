{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/block-history-rewrite.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/log-consult-session-read.mjs",
        "matcher": "Read",
        "timeout": 5
      }
    ]
  }
}
